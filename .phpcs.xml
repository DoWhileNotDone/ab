<?xml version="1.0"?>
<ruleset name="Project PSR-12">
    <description>Enforce PSR-12 on application and test PHP code.</description>

    <rule ref="PSR12"/>

    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>database</file>
    <file>public</file>
    <file>routes</file>
    <file>tests</file>

    <exclude-pattern>bootstrap/cache/*</exclude-pattern>
    <arg name="warning-severity" value="0"/>
</ruleset>
